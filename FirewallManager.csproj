<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>Firewall.ico</ApplicationIcon>
    <Version>1.9.2.0</Version>
    <AssemblyVersion>1.9.2.0</AssemblyVersion>
    <FileVersion>1.9.2.0</FileVersion>
    <LangVersion>latest</LangVersion>
    <Nullable>disable</Nullable>
    <DebugSymbols>false</DebugSymbols>
    <DebugType>none</DebugType>
    <Optimize>true</Optimize>
    <GenerateDocumentationFile>false</GenerateDocumentationFile>
  </PropertyGroup>

  <PropertyGroup Condition="'$(Configuration)' == 'Release'">
    <PublishSingleFile>true</PublishSingleFile>
    <SelfContained>false</SelfContained>
    <PublishReadyToRun>false</PublishReadyToRun>
    <PublishTrimmed>false</PublishTrimmed>
  </PropertyGroup>

  <ItemGroup>
    <Content Include="Lang\**\*" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <ItemGroup>
    <Compile Remove="FirewallManager.Tests\**\*" />
    <Content Remove="FirewallManager.Tests\**\*" />
    <EmbeddedResource Remove="FirewallManager.Tests\**\*" />
    <None Remove="FirewallManager.Tests\**\*" />
  </ItemGroup>

  <!-- 排除备份目录、发布产物目录，避免被 SDK 自动包含编译 -->
  <ItemGroup>
    <Compile Remove="backup-pre-refactor\**\*" />
    <Content Remove="backup-pre-refactor\**\*" />
    <EmbeddedResource Remove="backup-pre-refactor\**\*" />
    <None Remove="backup-pre-refactor\**\*" />
    <Compile Remove="publish\**\*" />
    <Content Remove="publish\**\*" />
    <EmbeddedResource Remove="publish\**\*" />
    <None Remove="publish\**\*" />
    <Compile Remove="release\**\*" />
    <Content Remove="release\**\*" />
    <EmbeddedResource Remove="release\**\*" />
    <None Remove="release\**\*" />
    <!-- 排除 tools 子项目目录，避免其 obj/bin 中的生成文件被主项目编译，导致 AssemblyXxxAttribute 重复 -->
    <Compile Remove="tools\**\*" />
    <Content Remove="tools\**\*" />
    <EmbeddedResource Remove="tools\**\*" />
    <None Remove="tools\**\*" />
  </ItemGroup>

</Project>